{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geensnor.nl/schemas/geensnor-feature-collection.json",
  "title": "Geensnor Hotspots",
  "type": "object",
  "required": ["type", "properties"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "name": { "type": "string" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/geensnorFeature" }
    }
  },
  "$defs": {
    "geensnorFeature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Point" },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": { "type": "number" }
            }
          }
        },
        "properties": {
          "type": "object",
          "required": ["name", "category", "description", "avoid"],
          "properties": {
            "name": { "type": "string" },
            "oneliner": { "type": "string" },
            "description": { "type": "string" },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "category": {
              "enum": [
                "bar",
                "restaurant",
                "trailerhelling",
                "overig",
                "overnachten",
                "koffie",
                "muziek",
                "strand",
                "snackbar"
              ]
            },
            "avoid": {
              "type": "boolean",
              "description": "Doodshoofdje of niet?"
            },
            "image": {
              "type": "string",
              "format": "url"
            }
          }
        }
      }
    }
  }
}
